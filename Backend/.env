# ==================== DATABASE ====================
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uth_confms
DB_USER=postgres
DB_PASSWORD=1234

# Constructed Database URL
DATABASE_URL=postgresql://postgres:1234@localhost:5432/uth_confms

# ==================== APPLICATION ====================
APP_ENV=development
DEBUG=True
PORT=5000

# ==================== SECURITY ====================
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here

# ==================== FILE UPLOAD ====================
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=pdf

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== EMAIL ====================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tamleminhtam437@gmail.com
MAIL_PASSWORD=wjsv wdbn ysmi jinx
MAIL_DEFAULT_SENDER=noreply@uth-confms.edu.vn

# ==================== CACHING ====================
# Options: simple, redis, memcached
CACHE_TYPE=simple
CACHE_TIMEOUT=300

# Redis Configuration (if using redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================== RATE LIMITING ====================
# Options: memory://, redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://

# ==================== INTERNATIONALIZATION ====================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,vi

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=app.log

# ==================== AUTO-ASSIGNMENT ====================
DEFAULT_PAPERS_PER_REVIEWER=3
DEFAULT_REVIEWERS_PER_PAPER=3

# ==================== OPTIONAL FEATURES ====================
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_AUDIT_LOGS=True
ENABLE_AUTO_ASSIGNMENT=True

