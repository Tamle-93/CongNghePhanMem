from sqlalchemy import Column, Integer, String, Boolean, create_engine
from sqlalchemy.orm import sessionmaker
from infrastructure.models.base import Base


class UMCAuthResource(Base):
    __tablename__ = "umc_auth_resource"

    id = Column(Integer, primary_key=True)
    resource_name = Column(String(255), nullable=False)
    permission = Column(String(255), nullable=False)
    is_active = Column(Boolean, default=True)

    def __repr__(self):
        return f"<UMCAuthResource {self.resource_name}:{self.permission}>"


if __name__ == "__main__":
    engine = create_engine("sqlite:///:memory:")
    Base.metadata.create_all(engine)

    Session = sessionmaker(bind=engine)
    session = Session()

    r = UMCAuthResource(resource_name="AI", permission="READ")
    session.add(r)
    session.commit()

    print(session.query(UMCAuthResource).all())
